<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borders"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Subject Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom de la matière"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvSubjectCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CODE101"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSubjectTeacher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enseignant"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Action Buttons: Eye, Pen, Trash -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- View / Eye Button -->
            <ImageButton
                android:id="@+id/btnViewSubject"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_eye"
                app:tint="@color/primary"
                android:contentDescription="Voir"
                android:padding="8dp" />

            <!-- Edit / Pen Button -->
            <ImageButton
                android:id="@+id/btnEditSubject"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_pen"
                app:tint="@color/secondary"
                android:contentDescription="Modifier"
                android:padding="8dp" />

            <!-- Delete / Trash Button -->
            <ImageButton
                android:id="@+id/btnDeleteSubject"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_trash"
                app:tint="@color/error"
                android:contentDescription="Supprimer"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
